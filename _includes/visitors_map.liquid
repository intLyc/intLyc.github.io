{% comment %}
  Compact visitors world map: bundled static image + CSS-positioned dots
  (no external tiles, no Leaflet attribution).
  Data comes from _data/visitors.yml, refreshed daily by
  .github/workflows/update-visitors.yml (GoatCounter API).
{% endcomment %}
<div class="visitors-map-wrap">
  <div class="visitors-map-img">
    <img
      class="only-light"
      src="{{ '/assets/img/world_map_light.png' | relative_url }}"
      alt="World map of visitors"
      loading="lazy"
    >
    <img
      class="only-dark"
      src="{{ '/assets/img/world_map_dark.png' | relative_url }}"
      alt="World map of visitors"
      loading="lazy"
    >
    <div class="visitors-map-dots" id="visitors-dots"></div>
  </div>
  {% if site.data.visitors.countries.size > 0 %}
    <div class="visitors-stats">
      {% for c in site.data.visitors.countries limit: 5 %}
        <span class="visitors-stat">{% if forloop.first %}visitors: {% endif %}<strong>{{ c.display_country }}</strong> {{ c.visitors }}</span>
      {% endfor %}
    </div>
  {% endif %}
</div>
<script>
  window.VISITORS_DATA = [
    {% for c in site.data.visitors.countries %}
      {"country": {{ c.country | jsonify }}, "visitors": {{ c.visitors }}, "display_country": {{ c.display_country | default: c.country | jsonify }}}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
</script>
<script src="{{ '/assets/js/visitors-map.js' | relative_url | bust_file_cache }}"></script>
